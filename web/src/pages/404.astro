---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" noindex>
  <div class="page narrow center stack">
    <img class="pixel" src="/art/pet_fox.png" alt="" width="128" height="128" style="margin-inline: auto" />
    <h1>Lost in the bamboo</h1>
    <p class="muted">This page slipped away like a shadow ninja. Let’s get you back to the village.</p>
    <p><a class="btn btn-primary" href="/">Back to the village</a></p>
  </div>
</Base>
