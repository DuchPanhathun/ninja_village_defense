# Copy to .env and fill in from Firebase console → Project settings → Your apps → Web app (project bookknhom).
# These values are public (they ship in the page); access is controlled by Auth, the Firestore rules and App Check.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=bookknhom.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=bookknhom
PUBLIC_FIREBASE_APP_ID=
# Must match FUNCTIONS_REGION in firebase/functions/.env
PUBLIC_FUNCTIONS_REGION=us-central1
# App Check (reCAPTCHA Enterprise site key). Leave empty until App Check is set up (WEB 7).
PUBLIC_RECAPTCHA_ENTERPRISE_KEY=

# Site details shown on the pages
PUBLIC_STUDIO_NAME=Ninja Village Studio
PUBLIC_SUPPORT_EMAIL=support@example.com
PUBLIC_PLAY_STORE_URL=
# true while PAYMENTS_PROVIDER=sandbox in the functions: the shop shows a "test mode" banner
PUBLIC_PAYMENTS_TEST_MODE=true
# Remove once a lawyer has reviewed the legal pages
PUBLIC_LEGAL_DRAFT=true
