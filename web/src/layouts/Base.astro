---
import { Font } from 'astro:assets';
import '../styles/global.css';
import AccountMenu from '../components/islands/AccountMenu';
import { site } from '../config';
import { t } from '../i18n';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  active?: 'home' | 'shop' | 'redeem' | 'account';
}

const { title, description = t.home.lead, noindex = false, active } = Astro.props;
const fullTitle = title === site.gameName ? title : `${title} · ${site.gameName}`;
const nav = [
  { key: 'shop', href: '/shop/', label: t.nav.shop },
  { key: 'redeem', href: '/redeem/', label: t.nav.redeem },
  { key: 'account', href: '/account/', label: t.nav.account },
] as const;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#121a22" />
    <link rel="icon" type="image/png" href="/art/app_icon.png" />
    <link rel="apple-touch-icon" href="/art/app_icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/art/app_icon.png', Astro.site)} />
    <Font cssVariable="--font-pixel" preload />
    <Font cssVariable="--font-body" preload />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="container header-row">
        <a class="brand" href="/" aria-label={`${site.gameName} — ${t.nav.home}`}>
          <img class="pixel" src="/art/logo_emblem.png" alt="" width="40" height="40" />
          <span>Ninja Village</span>
        </a>
        <nav class="main-nav" aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={active === item.key ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <div class="account-slot">
          <AccountMenu client:load />
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <img class="pixel" src="/art/logo_emblem.png" alt="" width="32" height="32" />
          <div>
            <strong>{site.gameName}</strong>
            <p class="small muted">© {year} {site.studioName}. {t.footer.rights}</p>
          </div>
        </div>
        <nav class="footer-links" aria-label="Footer">
          <a href="/support/">{t.footer.support}</a>
          <a href="/terms/">{t.footer.terms}</a>
          <a href="/privacy/">{t.footer.privacy}</a>
          <a href="/refunds/">{t.footer.refunds}</a>
          <a href="/delete-account/">{t.footer.deleteAccount}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 1rem;
    top: -3rem;
    z-index: 100;
    padding: 0.5rem 1rem;
    background: var(--lantern);
    color: #2a1a06;
    font-family: var(--font-ui);
  }
  .skip-link:focus { top: 0.75rem; }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(18, 26, 34, 0.9);
    backdrop-filter: blur(8px);
    border-bottom: var(--px) solid var(--ink);
    box-shadow: 0 var(--px) 0 rgba(243, 233, 214, 0.05);
  }
  .header-row {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas: 'brand account' 'nav nav';
    align-items: center;
    column-gap: 1rem;
    padding-block: 0.5rem;
  }
  .brand {
    grid-area: brand;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--paper);
    text-decoration: none;
    font: 700 1.25rem/1 var(--font-ui);
    letter-spacing: 0.02em;
  }
  .brand img { width: 40px; height: 40px; }
  .brand span { color: var(--lantern); text-shadow: 0 2px 0 var(--ink); }
  .account-slot { grid-area: account; justify-self: end; }
  .main-nav {
    grid-area: nav;
    display: flex;
    gap: 0.25rem;
    justify-content: center;
    padding-top: 0.35rem;
  }
  .main-nav a {
    flex: 1;
    max-width: 140px;
    text-align: center;
    padding: 0.45rem 0.5rem;
    color: var(--paper-dim);
    text-decoration: none;
    font: 700 1rem var(--font-ui);
    border-bottom: var(--px) solid transparent;
  }
  .main-nav a:hover { color: var(--paper); }
  .main-nav a[aria-current='page'] { color: var(--lantern); border-bottom-color: var(--lantern); }

  @media (min-width: 720px) {
    .header-row { grid-template-columns: auto 1fr auto; grid-template-areas: 'brand nav account'; padding-block: 0.6rem; }
    .main-nav { justify-content: flex-start; padding-top: 0; margin-left: 1.5rem; }
    .main-nav a { flex: none; }
  }

  main { flex: 1; display: flex; flex-direction: column; }

  .site-footer {
    border-top: var(--px) solid var(--ink);
    background: var(--night-2);
    padding-block: 2rem 2.5rem;
  }
  .footer-grid { display: grid; gap: 1.5rem; }
  .footer-brand { display: flex; gap: 0.75rem; align-items: flex-start; }
  .footer-brand img { width: 32px; height: 32px; margin-top: 2px; }
  .footer-brand strong { font-family: var(--font-ui); font-size: 1.05rem; }
  .footer-links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; }
  .footer-links a { color: var(--paper-dim); text-decoration: none; }
  .footer-links a:hover { color: var(--lantern); text-decoration: underline; }
  @media (min-width: 720px) {
    .footer-grid { grid-template-columns: 1fr auto; align-items: center; }
  }
</style>
