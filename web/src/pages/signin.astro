---
import Base from '../layouts/Base.astro';
import SignInForm from '../components/islands/SignInForm';
import { t } from '../i18n';
---

<Base title={t.signIn.title} description={t.signIn.lead} noindex>
  <div class="page narrow">
    <header class="page-head center">
      <img class="pixel" src="/art/logo_emblem.png" alt="" width="88" height="88" />
      <h1>{t.signIn.title}</h1>
      <p style="margin-inline: auto">{t.signIn.lead}</p>
    </header>
    <SignInForm client:load />
    <!-- Invisible reCAPTCHA for SMS 2-step codes (outside the island so it survives re-renders). -->
    <div id="mfa-recaptcha"></div>
  </div>
</Base>
