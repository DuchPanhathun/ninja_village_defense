# `npm run dev:emulator` — talks to the local Firebase emulators (no real project, no secrets).
PUBLIC_USE_EMULATORS=true
PUBLIC_FIREBASE_API_KEY=demo-api-key
PUBLIC_FIREBASE_AUTH_DOMAIN=demo-ninja.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=demo-ninja
PUBLIC_FIREBASE_APP_ID=demo-app
PUBLIC_FUNCTIONS_REGION=us-central1
PUBLIC_STUDIO_NAME=Ninja Village Studio
PUBLIC_SUPPORT_EMAIL=support@example.com
PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.thun.ninjavillagedefense
PUBLIC_PAYMENTS_TEST_MODE=true
PUBLIC_LEGAL_DRAFT=true
